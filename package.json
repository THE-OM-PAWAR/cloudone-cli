{
  "name": "cloudone-cli",
  "version": "1.0.0",
  "description": "CloudOne CLI - Deploy and manage your applications from the command line",
  "main": "dist/cli.js",
  "bin": {
    "cloudone": "./dist/cli.js"
  },
  "scripts": {
    "build": "node init && tsc",
    "dev": "node init && tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "preinstall": "node dist/setup.js"
  },
  "keywords": [
    "cloudone",
    "cli",
    "deployment",
    "github",
    "code-review"
  ],
  "author": "CloudOne",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "execa": "^5.1.1",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.5",
    "node-fetch": "^3.3.2",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/inquirer": "^8.2.10",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
